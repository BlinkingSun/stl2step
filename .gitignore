# Build output. NOTE: the build pattern is ROOT-ANCHORED on purpose.
# An unanchored 'build*/' also matched tests/gates/build_fixtures/ and
# tests/gates/buildtest/, silently hiding committed test data from git
# (FINDINGS-0 D5). Keep the leading slash.
/build*/
out/
cmake-build-*/

# CMake user files
CMakeUserPresets.json

# Conversion output / scratch
*.step
*.stp
!tests/**/*.step   # keep any intentional test fixtures

# Editor / OS cruft
.vscode/
.idea/
.cache/
compile_commands.json
.DS_Store
*.swp

# Gate runner output (regenerated by tests/gates/run_gates.py)
/gates-report.json

# Local three-platform CI green markers (scripts/ci-local-gate.sh).
# Never commit — they certify THIS machine's HEAD, not the tree.
.ci-local/

# Python bytecode
__pycache__/
*.pyc

# CTest output (generated at repo root by ctest runs)
Testing/
