inline bool parseOcctMajorMinor(const char* ver, int& major, int& minor) {
    if (ver == nullptr || ver[0] == '\0') {
        return false;
    }
    char* end = nullptr;
    const long maj = std::strtol(ver, &end, 10);
    if (end == ver || *end != '.') {
        return false;
    }
    const long min = std::strtol(end + 1, &end, 10);
    if (end == ver + 1) {
        return false;
    }
    major = static_cast<int>(maj);
    minor = static_cast<int>(min);
    return true;
}

inline bool occtVersionAtLeast(int major, int minor, const char* ver) {
    int foundMajor = 0;
    int foundMinor = 0;
    if (!parseOcctMajorMinor(ver, foundMajor, foundMinor)) {
        return false;
    }
    if (foundMajor != major) {
        return foundMajor > major;
    }
    return foundMinor >= minor;
}

inline bool occtCalibrated() {
    return occtVersionAtLeast(STL2STEP_OCCT_CALIBRATED_MIN_MAJOR,
                              STL2STEP_OCCT_CALIBRATED_MIN_MINOR,
                              effectiveOcctVersion());
}

// Returns STL2STEP_OCCT_SKIP_EXIT_CODE when the battery should skip; otherwise -1.
inline int skipExitIfUncalibrated() {
    if (occtCalibrated()) {
        return -1;
    }
    std::fprintf(stderr, "SKIP: calibrated on OCCT 7.9.x, found %s\n",
                 effectiveOcctVersion());
    return STL2STEP_OCCT_SKIP_EXIT_CODE;
}

