"""OCCT calibrated-battery helpers for gate runners (D-I-5 / GitHub #8)."""

from __future__ import annotations

import os
import re

OCCT_VERSION = "@OpenCASCADE_VERSION@"
CALIBRATED_MIN_MAJOR = @STL2STEP_OCCT_CALIBRATED_MIN_MAJOR@
CALIBRATED_MIN_MINOR = @STL2STEP_OCCT_CALIBRATED_MIN_MINOR@
SKIP_EXIT_CODE = @STL2STEP_OCCT_SKIP_EXIT_CODE@
G01_BASELINE_COMMIT = "@STL2STEP_G01_BASELINE_COMMIT@"

_VERSION_RE = re.compile(r"^(\d+)\.(\d+)")


def effective_occt_version() -> str:
    override = os.environ.get("STL2STEP_TEST_OCCT_VERSION", "").strip()
    if override:
        return override
    return OCCT_VERSION


def _parse_major_minor(ver: str) -> tuple[int, int] | None:
    m = _VERSION_RE.match(ver.strip())
    if not m:
        return None
    return int(m.group(1)), int(m.group(2))


def occt_version_at_least(major: int, minor: int, ver: str) -> bool:
    parsed = _parse_major_minor(ver)
    if parsed is None:
        return False
    found_major, found_minor = parsed
    if found_major != major:
        return found_major > major
    return found_minor >= minor


def occt_calibrated() -> bool:
    return occt_version_at_least(
        CALIBRATED_MIN_MAJOR, CALIBRATED_MIN_MINOR, effective_occt_version()
    )


def skip_message() -> str:
    return f"SKIP: calibrated on OCCT 7.9.x, found {effective_occt_version()}"
